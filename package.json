{
  "name": "@sudobility/types",
  "version": "1.9.76",
  "description": "Comprehensive TypeScript types, interfaces, and utilities for Web3 email applications - optimized for AI-assisted development",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./api": {
      "import": "./dist/types/api/indexer-responses.js",
      "types": "./dist/types/api/indexer-responses.d.ts",
      "default": "./dist/types/api/indexer-responses.js"
    },
    "./enums": {
      "import": "./dist/types/business/enums.js",
      "types": "./dist/types/business/enums.d.ts",
      "default": "./dist/types/business/enums.js"
    },
    "./blockchain": {
      "import": "./dist/types/blockchain/index.js",
      "types": "./dist/types/blockchain/index.d.ts",
      "default": "./dist/types/blockchain/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.esm.json",
    "clean": "rimraf dist",
    "dev": "tsc --watch",
    "test:unit": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json,md}\"",
    "typecheck": "tsc --noEmit",
    "verify": "bun run typecheck && bun run lint && bun run test:unit && bun run build",
    "ai:analyze": "node .ai/scripts/analyze-types.js",
    "ai:validate-exports": "node .ai/scripts/validate-exports.js",
    "ai:docs": "bun run ai:analyze && bun run ai:validate-exports",
    "prepublishOnly": "bun run clean && bun run verify"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "CLAUDE.md"
  ],
  "keywords": [
    "typescript",
    "types",
    "interfaces",
    "web3",
    "blockchain",
    "email",
    "ai-optimized",
    "tree-shakeable",
    "zero-dependencies"
  ],
  "author": "Sudobility",
  "license": "BUSL-1.1",
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "@types/node": "~24.19.2",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "eslint": "~9.39.5",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.7",
    "eslint-plugin-react-hooks": "~7.0.1",
    "eslint-plugin-react-refresh": "~0.4.26",
    "globals": "~16.5.0",
    "prettier": "~3.9.10",
    "rimraf": "~6.1.3",
    "typescript": "~5.9.3",
    "vitest": "~4.1.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/types.git"
  }
}
